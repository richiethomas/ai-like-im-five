---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and who writes it.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">About</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>What gets published here</h2>
        <p>
          This blog is my learning log. I'm working through <a href="https://30papers.com">30papers.com</a>, the reading list Ilya Sutskever reportedly gave to John Carmack, and writing down what I understand as I go. We're currently on paper #1: CS231n, a Stanford course on convolutional neural networks for computer vision.
        </p>
        <p>
          Each post breaks down one concept from the reading, built from first principles. No prerequisites. These are notes, not a textbook.
        </p>

        <h2>Who it is written for</h2>
        <p>
          Primarily: me. I'm autistic with ADHD, and these posts are structured the way my brain needs them: one concept at a time, everything defined, nothing assumed. To some readers that may come across as overly simple or dumbed-down. That's by design. If the notes help you too, great; that's a bonus, not the goal.
        </p>

        <h2>How it is written</h2>
        <p>
          I explain the math when it matters and skip it when it doesn't. If something is genuinely hard, I say so. Corrections and updates are made in place, with the date shown at the top of the post.
        </p>

        <h2>Who writes it</h2>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a>, {author.role} ({author.posts.length} {author.posts.length === 1 ? "post" : "posts"})
              </li>
            ))
          }
        </ul>

        <h2>Get in touch</h2>
        <p>
          Questions, corrections, and requests are welcome through the <a href="/contact/">contact page</a>.
        </p>
        {
          siteConfig.email && (
            <p>You can also email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> directly.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
