---
import { siteConfig } from "@/config/site";

/*
 * The compact subscribe form used once, in the home sidebar under the About
 * blurb. Monograph deliberately keeps a single signup point rather than
 * repeating a call to action at the end of every page.
 */
const newsletter = siteConfig.newsletter;
const action = newsletter.action.trim();
const isEnabled = newsletter.enabled;
/* No endpoint configured: the form stays interactive and a script confirms the
   submit locally instead of posting the page to nowhere. */
const isDemo = isEnabled && action.length === 0;
---

<section id="newsletter" aria-labelledby="newsletter-heading">
  <h3 id="newsletter-heading" class="text-base font-semibold tracking-tight">{newsletter.title}</h3>
  <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">{newsletter.description}</p>

  <form
    class="mt-5 grid gap-3"
    action={action || undefined}
    method={newsletter.method}
    target={action ? "_blank" : undefined}
    rel="noopener"
    data-newsletter-form={isDemo ? "" : undefined}
    data-newsletter-inline={!isDemo && action ? "" : undefined}
  >
    <label class="sr-only" for="newsletter-email">Email address</label>
    <input
      id="newsletter-email"
      required
      type="email"
      name={newsletter.emailFieldName}
      autocomplete="email"
      placeholder="you@example.com"
      disabled={!isEnabled}
      class="field"
    />
    <button type="submit" disabled={!isEnabled} class="btn btn-solid btn-block">
      {isEnabled ? "Subscribe" : "Coming soon"}
    </button>
    <p
      class="newsletter-status text-xs leading-relaxed text-muted-foreground"
      role="status"
      aria-live="polite"
      data-newsletter-status
    >
    </p>
    {!isEnabled && (
      <p class="text-xs leading-relaxed text-muted-foreground">
        Signup is disabled until a newsletter provider is configured.
      </p>
    )}
  </form>
</section>

{
  isDemo && (
    <script is:inline>
      document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const status = form.querySelector("[data-newsletter-status]");
          if (status) {
            status.textContent =
              "Thanks. This demo form is not connected to a provider yet, so nothing was sent.";
          }
          form.reset();
        });
      });
    </script>
  )
}

{
  !isDemo && action && (
    <script is:inline>
      /* Inline subscribe: post to the same-origin Pages Function so the reader
         never leaves the site. If the function is missing or errors, fall back
         to the plain form flow (Buttondown's hosted page in a new tab), which
         is also what no-JS visitors get. */
      document.querySelectorAll("[data-newsletter-inline]").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const status = form.querySelector("[data-newsletter-status]");
          const button = form.querySelector("button[type=submit]");
          const email = form.querySelector("input[name=email]")?.value || "";
          const say = (text) => {
            if (status) status.textContent = text;
          };
          if (button) button.disabled = true;
          say("Subscribing…");
          try {
            const res = await fetch("/api/subscribe", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email }),
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.ok) {
              say(
                data.code === "already-subscribed"
                  ? "You're already on the list."
                  : "Almost done. Check your inbox for a confirmation email."
              );
              form.reset();
            } else if (res.status === 400) {
              say("That email address doesn't look right. Mind checking it?");
            } else if (res.status === 429) {
              say("Too many attempts right now. Please try again in a minute.");
            } else {
              // Function unconfigured or upstream down: use the plain flow.
              // (Programmatic submit skips this handler, so no loop.)
              form.submit();
              return;
            }
          } catch {
            form.submit();
            return;
          } finally {
            if (button) button.disabled = false;
          }
        });
      });
    </script>
  )
}

<style>
  .newsletter-status:empty {
    display: none;
  }
</style>
